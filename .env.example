# ─── DATABASE (PostgreSQL via Prisma) ──────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_ielts?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/learning_ielts?schema=public"

# ─── BACKEND API CONNECTION ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── AUTHENTICATION & JWT ─────────────────────────────────────────────────────
JWT_SECRET="bap-english-super-secret-jwt-key-for-local-development-2026"

# ─── GOOGLE OAUTH 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# ─── AI SERVICES (Anthropic Claude) ───────────────────────────────────────────
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ─── APPLICATION ENVIRONMENT ──────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
